# 开发态：接口走 vite 代理（见 vite.config.ts），前端使用同源相对路径
VITE_API_BASE=
# 开发态不设 VITE_PUBLIC_BASE，页面就在 http://localhost:5175/ 根路径
# 代理目标，即 msg-svr 的 web.port
VITE_PROXY_TARGET=http://127.0.0.1:9002
# 认证模式：development 免登录（不拦截、不带 token，X-User-Id 固定 0）。
# 缺省按 required 处理，避免漏配就把登录关掉。
VITE_AUTH_MODE=disabled
# 认证接口前缀：开发期 adm 服务走 /adm。
VITE_AUTH_BASE=/adm
